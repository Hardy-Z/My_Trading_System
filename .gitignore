# Keep API credentials and local environment overrides out of version control.
.env
.env.*
!.env.example

# Ignore Python virtual environments and generated bytecode.
.venv/
venv/
__pycache__/
*.py[cod]

# Ignore test, type-checker, and coverage caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Ignore local logs, editor metadata, and generated distributions.
*.log
backtest_results/
.idea/
.vscode/
.dist/
dist/
build/
*.egg-info/
